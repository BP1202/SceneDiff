# Backend
APP_NAME=SceneDiff
APP_ENV=development
APP_DEBUG=true

# API
API_V1_PREFIX=/api/v1

# Database
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://POSTGRES_USER:POSTGRES_PASSWORD:5432/POSTGRES_DB

# Storage
UPLOAD_DIR=uploads
REPORT_DIR=reports

# Security
SECRET_MASKING=true
LOG_LEVEL=INFO